{
  "$schema": "https://swc.rs/schema.json",
  "module": {
    "type": "es6"
  },
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "tsx": true
    },
    "target": "es2022",
    "transform": {
      "decoratorVersion": "2022-03",
      "react": {
        "runtime": "automatic"
      }
    }
  }
}
